# 默认 mock 模式不需要供应商密钥。
VERIFIER_PROVIDER_MODE=mock
VERIFIER_DATABASE_PATH=./data/app.db
VERIFIER_MAX_INPUT_CHARS=20000
VERIFIER_MAX_CLAIMS=15
VERIFIER_TASK_TIMEOUT_SECONDS=180
VERIFIER_REQUEST_TIMEOUT_SECONDS=20
VERIFIER_MAX_CONCURRENCY=3
VERIFIER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live providers（不要提交真实值）
MODEL_API_KEY=
SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# MiMo 证据关系判断（只在 VERIFIER_JUDGE_MODE=mimo 时读取）
VERIFIER_JUDGE_MODE=off
# 独立启用语义切分：rules（默认本地规则）或 mimo（复用下方密钥/模型）。
VERIFIER_SEGMENT_MODE=rules
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# 模型调用预算：单次 5-90 秒；含排队、重试和退避的总预算 10-180 秒。
# 总预算还会受任务剩余时间限制；最多 3 次尝试，格式恢复最多 1 次。
MIMO_REQUEST_TIMEOUT_SECONDS=60
MIMO_TOTAL_TIMEOUT_SECONDS=120
MIMO_MAX_CONCURRENCY=2
MIMO_MAX_COMPLETION_TOKENS=1800
