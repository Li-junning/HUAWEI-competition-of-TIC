# Include inside nginx's http {}. Replace verifier.example.com and filesystem paths.
limit_req_zone $binary_remote_addr zone=verifier_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=verifier_connections:10m;
# Log path only: task query parameters and reviewer names are omitted.
log_format verifier_safe '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen 80;
    server_name verifier.example.com;
    return 308 https://verifier.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name verifier.example.com;
    if ($host != verifier.example.com) { return 444; }
    # A matching certificate must already exist; obtain/renew it with your host.
    ssl_certificate /etc/letsencrypt/live/verifier.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/verifier.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/verifier_access.log verifier_safe;
    root /srv/verifier/www;
    index index.html;
    autoindex off;
    client_max_body_size 4m;
    client_body_timeout 15s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    limit_conn verifier_connections 20;
    limit_req_status 429;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;

    # Never serve repository roots, hidden files, backups, databases or source maps.
    location ~ (^|/)\. { return 404; }
    location ~* \.(db|sqlite|sqlite3|py|toml|log|bak|zip|map)$ { return 404; }
    location /api/ {
        limit_req zone=verifier_requests burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host verifier.example.com;
        proxy_set_header X-Forwarded-Proto https;
        # Replace client-supplied forwarding headers; trust only this proxy in uvicorn.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 210s;
        proxy_cache off;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Strict-Transport-Security;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri /index.html; }
}
